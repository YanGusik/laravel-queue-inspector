{
    "name": "yangusik/laravel-queue-inspector",
    "description": "Static analyzer for Laravel queue job configurations",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "YanGusik\\QueueInspector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YanGusik\\QueueInspector\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/queue-inspector"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "YanGusik\\QueueInspector\\QueueInspectorServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "bin/queue-inspector",
        "analyse:strict": "bin/queue-inspector --strict"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
